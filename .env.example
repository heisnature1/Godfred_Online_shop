# Godfred's Fashion Shop Environment Configuration
# Copy this file to .env and adjust the values for your environment.

# ==============================================================================
# Security & Core
# ==============================================================================
DJANGO_SECRET_KEY=local-development-only-change-before-deploying
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ==============================================================================
# Database (Required on Vercel — SQLite will not work on serverless)
# Provide a PostgreSQL connection string, e.g. from Supabase:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# ==============================================================================
DATABASE_URL=

# ==============================================================================
# SSL & Production Security Headers
# ==============================================================================
# On Vercel set these to "True" and provide your Vercel domain(s).
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS=False
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# ==============================================================================
# Default Seed Credentials (Override as needed)
# ==============================================================================
DJANGO_SUPERUSER_PASSWORD=Aer!x1s#SuperAdm!n_2025
DJANGO_DEMO_PASSWORD=ShopNow#DemoUser!2025
